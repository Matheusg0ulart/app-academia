# ─── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=sua_chave_secreta_muito_longa_e_aleatoria
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Banco de Dados — Neon.tech (produção) ────────────────────
# Cole aqui a connection string gerada no painel do Neon.tech:
# https://console.neon.tech → seu projeto → Connection Details
DATABASE_URL=postgresql://usuario:senha@ep-xxx.us-east-2.aws.neon.tech/fitlife_ai_db?sslmode=require

# ─── Banco de Dados — PostgreSQL local (desenvolvimento) ──────
# Usado automaticamente quando DATABASE_URL não estiver definido
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_local
DB_NAME=fitlife_ai_db
